{
  "name": "artslicer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pieces": "node scripts/build-manifest.mjs",
    "pieces:placeholder": "node scripts/make-placeholder-pieces.mjs && npm run pieces",
    "pieces:generate": "node scripts/generate-pieces.mjs",
    "pieces:review": "node scripts/review-sheet.mjs"
  },
  "dependencies": {
    "konva": "^10.3.0",
    "peerjs": "^1.5.5",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-konva": "^19.2.5",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
