# The WebSocket relay (relay/ in this repo, deployed to Cloudflare). When set,
# all game traffic goes through it and works on any network, cellular
# included. For local play: `cd relay && npm run dev`, then
#   VITE_RELAY_URL=ws://localhost:8787
# For the Pages deploy, set the repository variable RELAY_URL instead.
VITE_RELAY_URL=

# Only used when no relay is set, by the WebRTC fallback.
# Optional TURN relay. Without it the game still works wherever the two
# devices can find a direct path — same wifi always, most home NATs — and
# fails on the cases that need a relay: either end on cellular, or a guest
# network with client isolation.
#
# Copy to .env.local for a local build, or set the same three as repository
# secrets (TURN_URLS, TURN_USERNAME, TURN_CREDENTIAL) for the Pages deploy.
#
# List every transport you are given. turns: on 443 is the one that survives
# a restrictive network, because it is indistinguishable from HTTPS.
VITE_TURN_URLS=turn:relay.example:3478,turn:relay.example:3478?transport=tcp,turns:relay.example:443
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
